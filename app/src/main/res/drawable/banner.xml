<!-- Original abstract banner art: sunset gradient, scanlines, joystick ball. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF1B2A4A"
                android:centerColor="#FF0E1526"
                android:endColor="#FF05070D" />
        </shape>
    </item>
    <item android:left="196dp" android:top="36dp" android:right="196dp" android:bottom="36dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFB300" />
        </shape>
    </item>
    <item android:left="212dp" android:top="52dp" android:right="212dp" android:bottom="52dp">
        <shape android:shape="oval">
            <solid android:color="#FF0E1526" />
        </shape>
    </item>
    <item android:left="228dp" android:top="68dp" android:right="228dp" android:bottom="68dp">
        <shape android:shape="oval">
            <solid android:color="#FFE53935" />
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp" android:top="140dp" android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
